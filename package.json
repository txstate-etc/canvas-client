{
  "name": "canvas-client",
  "version": "3.0.0",
  "description": "Typescript library to make accessing the Canvas API more convenient.",
  "main": "lib/index.js",
  "module": "lib-esm/index.js",
  "browser": {
    "./lib/index.js": "./lib/browser.js",
    "./lib-esm/index.js": "./lib-esm/browser.js"
  },
  "exports": {
    ".": {
      "types": "./lib-esm/index.d.ts",
      "browser": {
        "require": "./lib/browser.js",
        "import": "./lib-esm/browser.js"
      },
      "require": "./lib/index.js",
      "import": "./lib-esm/index.js"
    },
    "./graphql": {
      "types": "./lib-esm/graphql.d.ts",
      "require": "./lib/graphql.js",
      "import": "./lib-esm/graphql.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./lib-esm/index.d.ts",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepublishOnly": "npm run build",
    "build": "rm -rf lib lib-esm && tsc && tsc -m es2022 --outDir lib-esm --moduleResolution bundler && cp package-esm.json lib-esm/package.json",
    "lint": "eslint --no-warn-ignored src/**/*.ts test/**/*.ts",
    "test": "node --env-file-if-exists=.env --import tsx --test --test-concurrency=1 test/*.ts",
    "only": "node --env-file-if-exists=.env --import tsx --test --test-concurrency=1 --test-only test/*.ts",
    "genclient": "./genclient.sh"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/txstate-etc/canvas-client.git"
  },
  "keywords": [],
  "author": "Nick Wing",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/txstate-etc/canvas-client/issues"
  },
  "homepage": "https://github.com/txstate-etc/canvas-client#readme",
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/chai": "^5.2.3",
    "@types/luxon": "^3.7.6",
    "@types/node": "^26.0.0",
    "chai": "^6.3.0",
    "eslint-config-love": "^158.0.0",
    "luxon": "^3.7.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2"
  },
  "dependencies": {
    "txstate-utils": "^1.10.4"
  },
  "sideEffects": false,
  "files": [
    "lib/**/*",
    "lib-esm/**/*"
  ]
}
